<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuResume"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_resume" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuSaveState"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/menu_save_state" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuLoadState"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="4dp"
                android:text="@string/menu_load_state" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuFastForward"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/menu_fast_forward_on" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuCheats"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="4dp"
                android:text="@string/menu_cheats" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuLayout"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/menu_layout" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuSwap"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="4dp"
                android:text="@string/menu_swap" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuScreenshot"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/menu_screenshot" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuLid"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="4dp"
                android:text="@string/menu_close_lid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuReset"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/menu_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="4dp"
                android:text="@string/menu_settings" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuExit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/menu_exit" />
    </LinearLayout>
</ScrollView>
