<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NinDS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ninds_primary</item>
        <item name="colorOnPrimary">@color/ninds_on_primary</item>
        <item name="colorPrimaryContainer">@color/ninds_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ninds_on_primary_container</item>
        <item name="colorSecondary">@color/ninds_secondary</item>
        <item name="colorSurface">@color/ninds_surface</item>
        <item name="android:colorBackground">@color/ninds_background</item>
        <item name="android:windowBackground">@color/ninds_background</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="nindsCardColor">@color/ninds_card</item>
    </style>

    <!-- The game draws edge to edge on black; dialogs over it follow the app theme. -->
    <style name="Theme.NinDS.Emulator" parent="Theme.NinDS">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Accent overlays, laid over Theme.NinDS by NinDSApp before each activity inflates. -->
    <style name="ThemeOverlay.NinDS.Accent.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue_primary</item>
        <item name="colorOnPrimary">@color/accent_blue_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_blue_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_blue_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_blue_on_container</item>
    </style>
    <style name="ThemeOverlay.NinDS.Accent.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple_primary</item>
        <item name="colorOnPrimary">@color/accent_purple_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_purple_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_purple_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_purple_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_purple_on_container</item>
    </style>
    <style name="ThemeOverlay.NinDS.Accent.Green" parent="">
        <item name="colorPrimary">@color/accent_green_primary</item>
        <item name="colorOnPrimary">@color/accent_green_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_green_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_green_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_green_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_green_on_container</item>
    </style>
    <style name="ThemeOverlay.NinDS.Accent.Orange" parent="">
        <item name="colorPrimary">@color/accent_orange_primary</item>
        <item name="colorOnPrimary">@color/accent_orange_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_orange_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_orange_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_orange_on_container</item>
    </style>
    <style name="ThemeOverlay.NinDS.Accent.Pink" parent="">
        <item name="colorPrimary">@color/accent_pink_primary</item>
        <item name="colorOnPrimary">@color/accent_pink_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_pink_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_pink_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_pink_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_pink_on_container</item>
    </style>
    <style name="ThemeOverlay.NinDS.Accent.Teal" parent="">
        <item name="colorPrimary">@color/accent_teal_primary</item>
        <item name="colorOnPrimary">@color/accent_teal_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_teal_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_teal_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_teal_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_teal_on_container</item>
