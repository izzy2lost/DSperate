    <style name="ThemeOverlay.NinDS.Accent.Gold" parent="">
        <item name="colorPrimary">@color/accent_gold_primary</item>
        <item name="colorOnPrimary">@color/accent_gold_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_gold_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_gold_on_container</item>
        <item name="colorSecondaryContainer">@color/accent_gold_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_gold_on_container</item>
    </style>

    <!-- Black (AMOLED): the dark theme with true-black backgrounds. -->
    <style name="ThemeOverlay.NinDS.Black" parent="">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">#0B0B0C</item>
        <item name="colorSurfaceContainer">#111113</item>
        <item name="colorSurfaceContainerHigh">#18181B</item>
        <item name="colorSurfaceContainerHighest">#202024</item>
        <item name="nindsCardColor">#121214</item>
    </style>
</resources>
