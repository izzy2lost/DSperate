<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi internet play (Wiimmfi) and local wireless go through the network like any other app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local wireless: hearing other NinDS/melonDS sessions' broadcast beacons on the Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only when Settings > Microphone is "Phone microphone", for games that listen (Nintendogs, Brain Age). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".NinDSApp"
        android:allowBackup="true"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NinDS">

        <activity
            android:name=".LibraryActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- "Open with NinDS" from file managers. DS ROMs have no registered MIME type,
                 so providers hand them over as octet-stream or zip. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-nintendo-ds-rom" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <!-- One game per process: ending it on exit gives the next game a clean recompiler
             and guest memory. -->
        <activity
            android:name=".EmulatorActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":emu"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.NinDS.Emulator" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".ControllerMappingActivity"
            android:exported="false"
            android:label="@string/pref_controller_mapping" />
    </application>

</manifest>
